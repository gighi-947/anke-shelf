{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/gighi-947/anke-shelf/contracts/progress/progress.schema.json",
  "title": "progress.json",
  "type": "object",
  "required": ["version", "progress"],
  "properties": {
    "version": { "const": 2 },
    "progress": {
      "type": "object",
      "additionalProperties": { "$ref": "#/definitions/entry" }
    }
  },
  "definitions": {
    "entry": {
      "type": "object",
      "required": ["chapter_index", "text_offset"],
      "properties": {
        "chapter_index": { "type": "integer", "minimum": 0 },
        "text_offset": { "type": "integer", "minimum": 0 },
        "updated_at": { "type": "string" },
        "page_index": { "type": "integer", "minimum": -1, "default": -1 },
        "page_total": { "type": "integer", "minimum": -1, "default": -1 },
        "scroll_ratio": { "type": "number", "minimum": -1, "maximum": 1, "default": -1 }
      },
      "additionalProperties": true
    }
  }
}
