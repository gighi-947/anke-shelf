{
  "id": "04-image-ratio-anchor",
  "description": "全图页滚动比例锚点：offset 相同但比例变化必须再落盘；文本锚点回归时清除比例。",
  "initial": { "chapter": 0, "offset": 0, "stored": null },
  "events": [
    { "type": "scroll", "chapter": 0, "offset": 500, "page": -1, "total": -1, "ratio": 0.5, "at": 0 },
    { "type": "debounce", "chapter": 0, "at": 500 },
    { "type": "scroll", "chapter": 0, "offset": 500, "page": -1, "total": -1, "ratio": -1, "at": 1000 },
    { "type": "debounce", "chapter": 0, "at": 1500 }
  ],
  "expect": {
    "persists": [
      { "chapter": 0, "offset": 500, "page": -1, "total": -1, "ratio": 0.5 },
      { "chapter": 0, "offset": 500, "page": -1, "total": -1, "ratio": -1 }
    ]
  }
}
